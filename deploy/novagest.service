# Sin Docker: prepare /opt/novagest/venv and /etc/novagest/novagest.env first, then enable this unit.
[Unit]
Description=NovaGest (gestión de negocio: inventario, venta y caja)
After=network.target

[Service]
User=novagest
WorkingDirectory=/opt/novagest
Environment=PORT=8080 DATA_DIR=/var/lib/novagest TRUST_PROXY=0 NOVAGEST_DEMO_USERS=0
EnvironmentFile=/etc/novagest/novagest.env
ExecStart=/opt/novagest/venv/bin/python server/novagest_server.py
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/novagest

[Install]
WantedBy=multi-user.target
