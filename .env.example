# Copie a .env y cambie los valores; nunca versionar secretos reales.
PORT=8080
DATA_DIR=./data
# En primera ejecución, configure una contraseña fuerte del Administrador.
NOVAGEST_DEMO_USERS=0
NOVAGEST_ADMIN_USER=admin
NOVAGEST_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_UNICA_DE_10_CARACTERES_O_MAS
# TRUST_PROXY=1 solo si un proxy inverso de confianza es el único acceso al servidor.
TRUST_PROXY=0
# Provisionar y respaldar de forma segura. No comparta LICENSE_SECRET con BACKUP_KEY.
# LICENSE_SECRET=secreto_aleatorio_compartido_con_el_generador_de_licencias
# BACKUP_KEY=secreto_aleatorio_independiente_para_copias
