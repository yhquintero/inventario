<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en compilaciones de prueba (debug): permite probar contra un servidor
     de la red local sin HTTPS o con el certificado mkcert de la laptop
     (confia en las CA instaladas por el usuario). La version release exige
     HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
