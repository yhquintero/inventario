<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget Nebula: índigo noche degradado con trazo cian neón. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#EE171038"
        android:endColor="#EE0C1E30"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#4038E0FF" />
</shape>
